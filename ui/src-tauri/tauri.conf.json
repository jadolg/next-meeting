{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Next Meeting",
  "mainBinaryName": "next-meeting-ui",
  "version": "0.1.0",
  "identifier": "io.github.nextmeeting.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Next Meeting",
        "width": 980,
        "height": 680,
        "minWidth": 360,
        "minHeight": 380,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/next-meeting"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Interactive desktop schedule and meeting status monitor powered by next-meeting CLI",
    "category": "Productivity"
  }
}
